<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cognifyz - Validation & Storage (Task 2)</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body style="font-family: 'Outfit', sans-serif; background: linear-gradient(135deg, #0f172a 0%, #020617 100%); color: #f8fafc; min-height: 100vh; margin: 0; padding: 2rem 1rem; display: flex; flex-direction: column; align-items: center; justify-content: flex-start;">

  <div style="width: 100%; max-width: 850px; display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1rem;">
    
    <!-- LEFT SIDE: Form & Client-Side Validation -->
    <div style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 1rem; padding: 2rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3);">
      
      <div style="margin-bottom: 1.5rem;">
        <span style="font-size: 0.75rem; background: #6366f1; color: white; padding: 0.25rem 0.6rem; border-radius: 9999px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">Level 1 - Task 2</span>
        <h2 style="font-size: 1.5rem; font-weight: 700; margin-top: 0.5rem; margin-bottom: 0.25rem;">Registration Form</h2>
        <p style="color: #94a3b8; font-size: 0.85rem;">Client-side + Server-side Validation</p>
      </div>

      <% if (success) { %>
        <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); color: #34d399; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.875rem; margin-bottom: 1rem;">
          ✓ Record validated and stored in server storage!
        </div>
      <% } %>

      <% if (errors.length > 0) { %>
        <div style="background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); color: #fca5a5; padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 0.85rem; margin-bottom: 1rem;">
          <strong style="display: block; margin-bottom: 0.25rem;">Server-side Validation Failed:</strong>
          <ul style="margin-left: 1rem; padding: 0;">
            <% errors.forEach(function(err) { %>
              <li><%= err.msg %></li>
            <% }); %>
          </ul>
        </div>
      <% } %>

      <form id="regForm" action="/submit" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
        
        <!-- Username Field -->
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.35rem; color: #cbd5e1;">Username *</label>
          <input type="text" id="username" name="username" value="<%= prevData.username || '' %>" placeholder="letters, numbers, underscore" style="width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.4rem; padding: 0.6rem 0.8rem; color: white; font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s;">
          <span id="usernameErr" style="color: #ef4444; font-size: 0.75rem; display: block; margin-top: 0.25rem; min-height: 1rem;"></span>
        </div>

        <!-- Email Field -->
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.35rem; color: #cbd5e1;">Email Address *</label>
          <input type="email" id="email" name="email" value="<%= prevData.email || '' %>" placeholder="your@email.com" style="width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.4rem; padding: 0.6rem 0.8rem; color: white; font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s;">
          <span id="emailErr" style="color: #ef4444; font-size: 0.75rem; display: block; margin-top: 0.25rem; min-height: 1rem;"></span>
        </div>

        <!-- Phone Field -->
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.35rem; color: #cbd5e1;">Phone Number (10 digits) *</label>
          <input type="text" id="phone" name="phone" value="<%= prevData.phone || '' %>" placeholder="e.g. 9876543210" style="width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.4rem; padding: 0.6rem 0.8rem; color: white; font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s;">
          <span id="phoneErr" style="color: #ef4444; font-size: 0.75rem; display: block; margin-top: 0.25rem; min-height: 1rem;"></span>
        </div>

        <!-- Age Field -->
        <div>
          <label style="display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 0.35rem; color: #cbd5e1;">Age (18 - 100) *</label>
          <input type="number" id="age" name="age" value="<%= prevData.age || '' %>" placeholder="e.g. 21" style="width: 100%; box-sizing: border-box; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 0.4rem; padding: 0.6rem 0.8rem; color: white; font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s;">
          <span id="ageErr" style="color: #ef4444; font-size: 0.75rem; display: block; margin-top: 0.25rem; min-height: 1rem;"></span>
        </div>

        <button type="submit" id="submitBtn" style="width: 100%; background: #6366f1; color: white; border: none; border-radius: 0.4rem; padding: 0.75rem; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-top: 0.5rem;">Register Now</button>
      </form>
    </div>

    <!-- RIGHT SIDE: Stored Server Data -->
    <div style="background: rgba(30, 41, 59, 0.2); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 1rem; padding: 2rem; display: flex; flex-direction: column; justify-content: flex-start;">
      
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Server Temp Storage</h2>
          <p style="color: #94a3b8; font-size: 0.85rem; margin: 0;">Validated Submissions (<%= submissions.length %>)</p>
        </div>
        <% if (submissions.length > 0) { %>
          <form action="/clear" method="POST">
            <button type="submit" style="background: transparent; color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.6rem; border-radius: 0.25rem; cursor: pointer; transition: all 0.2s;">Clear</button>
          </form>
        <% } %>
      </div>

      <div style="display: flex; flex-direction: column; gap: 0.75rem; overflow-y: auto; max-height: 380px; padding-right: 0.25rem;">
        <% if (submissions.length === 0) { %>
          <div style="text-align: center; border: 1px dashed rgba(255, 255, 255, 0.08); padding: 3rem 1rem; border-radius: 0.5rem; color: #64748b;">
            <p style="font-size: 1.25rem; margin-bottom: 0.25rem;">✦</p>
            <p style="font-size: 0.85rem; margin: 0;">No active submissions stored.</p>
          </div>
        <% } else { %>
          <% submissions.forEach(function(sub) { %>
            <div style="background: rgba(15, 23, 42, 0.4); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 0.5rem; padding: 1rem; position: relative;">
              <span style="position: absolute; right: 1rem; top: 1rem; font-size: 0.7rem; color: #64748b;"><%= sub.timestamp %></span>
              <div style="font-weight: 600; color: #818cf8; font-size: 0.95rem; margin-bottom: 0.25rem;">@<%= sub.username %></div>
              <div style="font-size: 0.8rem; color: #cbd5e1; margin-bottom: 0.15rem;">Email: <%= sub.email %></div>
              <div style="font-size: 0.8rem; color: #cbd5e1; margin-bottom: 0.15rem;">Phone: <%= sub.phone %></div>
              <div style="font-size: 0.8rem; color: #cbd5e1;">Age: <%= sub.age %></div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Client-side validations
    const form = document.getElementById('regForm');
    const username = document.getElementById('username');
    const email = document.getElementById('email');
    const phone = document.getElementById('phone');
    const age = document.getElementById('age');

    const usernameErr = document.getElementById('usernameErr');
    const emailErr = document.getElementById('emailErr');
    const phoneErr = document.getElementById('phoneErr');
    const ageErr = document.getElementById('ageErr');
    const submitBtn = document.getElementById('submitBtn');

    function validateUsername() {
      const val = username.value.trim();
      if (val.length < 3) {
        username.style.borderColor = '#ef4444';
        usernameErr.innerText = 'Username must be at least 3 characters';
        return false;
      }
      if (!/^[a-zA-Z0-9_]+$/.test(val)) {
        username.style.borderColor = '#ef4444';
        usernameErr.innerText = 'Alphanumeric & underscores only';
        return false;
      }
      username.style.borderColor = '#10b981';
      usernameErr.innerText = '';
      return true;
    }

    function validateEmail() {
      const val = email.value.trim();
      const re = /^\w+([.-]?\w+)*@\w+([.-]?\w+)*(\.\w{2,3})+$/;
      if (!re.test(val)) {
        email.style.borderColor = '#ef4444';
        emailErr.innerText = 'Enter a valid email address';
        return false;
      }
      email.style.borderColor = '#10b981';
      emailErr.innerText = '';
      return true;
    }

    function validatePhone() {
      const val = phone.value.trim();
      if (!/^\d{10}$/.test(val)) {
        phone.style.borderColor = '#ef4444';
        phoneErr.innerText = 'Phone must be exactly 10 digits';
        return false;
      }
      phone.style.borderColor = '#10b981';
      phoneErr.innerText = '';
      return true;
    }

    function validateAge() {
      const val = parseInt(age.value);
      if (isNaN(val) || val < 18 || val > 100) {
        age.style.borderColor = '#ef4444';
        ageErr.innerText = 'Age must be between 18 and 100';
        return false;
      }
      age.style.borderColor = '#10b981';
      ageErr.innerText = '';
      return true;
    }

    // Attach listeners
    username.addEventListener('input', validateUsername);
    email.addEventListener('input', validateEmail);
    phone.addEventListener('input', validatePhone);
    age.addEventListener('input', validateAge);

    form.addEventListener('submit', function(e) {
      const isU = validateUsername();
      const isE = validateEmail();
      const isP = validatePhone();
      const isA = validateAge();

      if (!(isU && isE && isP && isA)) {
        e.preventDefault(); // Stop form submission
        submitBtn.style.background = '#ef4444';
        setTimeout(() => {
          submitBtn.style.background = '#6366f1';
        }, 1000);
      }
    });
  </script>
</body>
</html>
